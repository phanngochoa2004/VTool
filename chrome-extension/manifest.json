{
  "manifest_version": 3,
  "name": "CVAT 3D Multi-Frame QA/QC Inspector",
  "version": "1.3.1",
  "description": "CVAT 3D multi-frame QA/QC inspector with cuboid hotkeys, track tools and single-face resizing without server requests.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "<all_urls>"
      ],
      "js": [
        "src/config/version.js",
        "src/config/allowed_sites.js",
        "src/engine/math_3d.js",
        "src/engine/ortho_canvas.js",
        "src/core/pcd_cache.js",
        "src/core/track_reader.js",
        "src/core/cvat_hook.js",
        "src/core/size_clipboard.js",
        "src/core/hotkey_preferences.js",
        "src/core/workspace_layout.js",
        "src/core/hotkeys.js",
        "src/core/hotkeys_autostart.js",
        "src/ui/frame_card.js",
        "src/ui/macos_dock.js",
        "content/injector.js"
      ],
      "css": [
        "src/ui/macos_theme.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
