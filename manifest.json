{
  "manifest_version": 3,
  "name": "CVAT 3D Multi-Frame QA/QC Inspector",
  "version": "1.1.0",
  "description": "macOS HIG multi-frame 3D orthogonal (Top, Front, Side) QA/QC inspection tool for CVAT point clouds without server requests.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": [
        "content/bundle.js"
      ],
      "css": [
        "src/ui/macos_theme.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
